    SEMI            reduce using rule 11 (statement -> FONCTIONVALUE NAME LPAREN NAME COLON NAME RPAREN LACC bloc RACC .)
    RPAREN          reduce using rule 11 (statement -> FONCTIONVALUE NAME LPAREN NAME COLON NAME RPAREN LACC bloc RACC .)


state 104

    (5) statement -> IF LPAREN expression RPAREN LACC bloc RACC ELSE LACC bloc RACC .

    SEMI            reduce using rule 5 (statement -> IF LPAREN expression RPAREN LACC bloc RACC ELSE LACC bloc RACC .)
    RPAREN          reduce using rule 5 (statement -> IF LPAREN expression RPAREN LACC bloc RACC ELSE LACC bloc RACC .)


state 105

    (7) statement -> FOR LPAREN statement SEMI expression SEMI statement RPAREN LACC bloc RACC .

    SEMI            reduce using rule 7 (statement -> FOR LPAREN statement SEMI expression SEMI statement RPAREN LACC bloc RACC .)
    RPAREN          reduce using rule 7 (statement -> FOR LPAREN statement SEMI expression SEMI statement RPAREN LACC bloc RACC .)

