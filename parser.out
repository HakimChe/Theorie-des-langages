Grammar

Rule 0     S' -> start
Rule 1     start -> bloc
Rule 2     bloc -> bloc statement SEMI
Rule 3     bloc -> statement SEMI
Rule 4     statement -> IF LPAREN expression RPAREN LACC bloc RACC
Rule 5     statement -> IF LPAREN expression RPAREN LACC bloc RACC ELSE LACC bloc RACC
Rule 6     statement -> WHILE LPAREN expression RPAREN LACC bloc RACC
Rule 7     statement -> FOR LPAREN statement SEMI expression SEMI statement RPAREN LACC bloc RACC
Rule 8     statement -> NAME PLUSEGAL expression
Rule 9     statement -> NAME PLUSPLUS
Rule 10    statement -> RETURN expression
Rule 11    statement -> FONCTIONVALUE NAME LPAREN NAME COLON NAME RPAREN LACC bloc RACC
Rule 12    expression -> NAME LPAREN expression COLON expression RPAREN
Rule 13    statement -> expression SEMI
Rule 14    statement -> NAME LBRACK RBRACK EGAL LBRACK expression SEMI expression RBRACK
Rule 15    statement -> NAME LBRACK expression RBRACK EGAL expression
Rule 16    expression -> NAME LBRACK expression RBRACK
Rule 17    statement -> PRINT LPAREN expression RPAREN
Rule 18    statement -> NAME EGAL expression
Rule 19    expression -> expression INF expression
Rule 20    expression -> STRING
Rule 21    expression -> expression INFEG expression
Rule 22    expression -> expression SUP expression
Rule 23    expression -> expression EGALEGAL expression
Rule 24    expression -> expression AND expression
Rule 25    expression -> expression OR expression
Rule 26    expression -> expression PLUS expression
Rule 27    expression -> expression TIMES expression
Rule 28    expression -> expression MINUS expression
Rule 29    expression -> expression DIVIDE expression
Rule 30    expression -> LPAREN expression RPAREN
Rule 31    expression -> NUMBER
Rule 32    expression -> NAME

